#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
#include <stdexcept>

template <typename T>
class Product {
    T id;
    std::string name;
    int quantity;
    double price;

public:
    Product(T id, std::string name, int quantity, double price)
        : id(id), name(name), quantity(quantity), price(price) {}

    T getId() const { return id; }
    std::string getName() const { return name; }
    int getQuantity() const { return quantity; }
    double getPrice() const { return price; }

    void updateQuantity(int q) { quantity = q; }
    void updatePrice(double p) { price = p; }

    void display() const {
        std::cout << "ID: " << id
                  << " | Name: " << name
                  << " | Qty: " << quantity
                  << " | Price: " << price << std::endl;
    }

    bool operator==(const Product<T>& other) const {
        return id == other.id;
    }
};

template <typename T>
void addProduct(std::vector<Product<T>>& inventory, const Product<T>& product) {
    inventory.push_back(product);
}

template <typename T>
void removeProduct(std::vector<Product<T>>& inventory, T id) {
    auto it = std::find_if(inventory.begin(), inventory.end(),
        [id](const Product<T>& p) { return p.getId() == id; });

    if (it != inventory.end()) {
        inventory.erase(it);
        std::cout << "Product removed successfully.\n";
    } else {
        throw std::runtime_error("Product not found!");
    }
}

template <typename T>
void updateProduct(std::vector<Product<T>>& inventory, T id, int newQty, double newPrice) {
    auto it = std::find_if(inventory.begin(), inventory.end(),
        [id](const Product<T>& p) { return p.getId() == id; });

    if (it != inventory.end()) {
        it->updateQuantity(newQty);
        it->updatePrice(newPrice);
        std::cout << "Product updated successfully.\n";
    } else {
        throw std::runtime_error("Product not found!");
    }
}

template <typename T>
void displayInventory(const std::vector<Product<T>>& inventory) {
    if (inventory.empty()) {
        std::cout << "Inventory is empty.\n";
        return;
    }
    for (const auto& item : inventory) {
        item.display();
    }
}

int main() {
    std::vector<Product<int>> inventory;
    int choice;

    do {
        std::cout << "\n--- Inventory Management System ---\n";
        std::cout << "1. Add Product\n";
        std::cout << "2. Remove Product\n";
        std::cout << "3. Update Product\n";
        std::cout << "4. Display Inventory\n";
        std::cout << "5. Exit\n";
        std::cout << "Enter choice: ";
        std::cin >> choice;

        try {
            if (choice == 1) {
                int id, qty;
                double price;
                std::string name;
                std::cout << "Enter ID, Name, Quantity, Price: ";
                std::cin >> id >> name >> qty >> price;
                addProduct(inventory, Product<int>(id, name, qty, price));
            } else if (choice == 2) {
                int id;
                std::cout << "Enter Product ID to remove: ";
                std::cin >> id;
                removeProduct(inventory, id);
            } else if (choice == 3) {
                int id, qty;
                double price;
                std::cout << "Enter Product ID, New Quantity, New Price: ";
                std::cin >> id >> qty >> price;
                updateProduct(inventory, id, qty, price);
            } else if (choice == 4) {
                displayInventory(inventory);
            } else if (choice == 5) {
                std::cout << "Exiting program...\n";
            } else {
                std::cout << "Invalid choice!\n";
            }
        } catch (const std::exception& e) {
            std::cout << "Error: " << e.what() << std::endl;
        }

    } while (choice != 5);

    return 0;
}
